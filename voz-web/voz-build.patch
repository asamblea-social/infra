   window.onresize = () => ui.updateSize()
   ui.updateSize()
+  vozInicio()
+}
+
+// ---------- voz.asamblea.social: entrada con la cuenta de Asamblea Social ----------
+const VOZ_MARCA = 'voz_ya_entro'
+function vozLeerMarca () { try { return window.localStorage.getItem(VOZ_MARCA) === '1' } catch (e) { return false } }
+function vozPonerMarca () { try { window.localStorage.setItem(VOZ_MARCA, '1') } catch (e) {} }
+function vozIrAlPuente () { window.location.assign(window.mumbleWebConfig.voz.login) }
+
+function vozInicio () {
+  if (!window.mumbleWebConfig.voz) return          // sin config.voz: comportamiento original
+  ui.connectDialog.hide()
+  const frag = new URLSearchParams(window.location.hash.slice(1))
+  if (window.location.hash) {
+    // borrar de inmediato el boleto de la barra de direcciones y del historial
+    window.history.replaceState(null, '', window.location.pathname + window.location.search)
+  }
+  const usuario = frag.get('u')
+  const boleto = frag.get('t')
+  const error = frag.get('error')
+  if (usuario && boleto) {
+    ui.vozModo('conectando')
+    ui.vozUsandoBoleto = true
+    ui.connectDialog.username(usuario)
+    ui.connectDialog.password(boleto)
+    ui.connectDialog.connect()
+    return
+  }
+  if (error) {
+    ui.vozError(error)
+    ui.vozModo('error')
+    return
+  }
+  if (vozLeerMarca()) {
+    vozIrAlPuente()
+    return
+  }
+  ui.vozModo('portada')
 }
 
 function log () {
